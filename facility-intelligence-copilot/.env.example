# Application Environment
APP_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg://facility_user:facility_password@localhost:5432/facility_intelligence

# Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=facility-telemetry-group
KAFKA_TELEMETRY_TOPIC=facility.telemetry

# SNS Workbench Webhook Integration
SNS_WEBHOOK_TEST_URL=
SNS_WEBHOOK_PRODUCTION_URL=
SNS_API_KEY=
SNS_AGENT_ID=facility-xray-demo
SNS_WEBHOOK_SIGNING_SECRET=

# API Authentication (Set to true to enforce API Key auth)
API_AUTH_ENABLED=false
API_KEYS=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation Configuration
SIMULATION_INTERVAL_SECONDS=5
SIMULATOR_ASSET_ID=7
